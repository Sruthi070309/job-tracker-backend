PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/JobTrack?retryWrites=true&w=majority
JWT_SECRET=put-a-long-random-text-here
JWT_EXPIRES_IN=7d

# Websites allowed to call this API (comma separated). Localhost is always allowed outside production.
CORS_ORIGINS=

# Used once by: npm run create-admin
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-strong-password
